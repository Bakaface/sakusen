{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"${SAKUSEN_DONE_DIR:-}\" ] && mkdir -p \"$SAKUSEN_DONE_DIR\" && tmp=\"$SAKUSEN_DONE_DIR/.$$.$(date +%s%N).tmp\" && cat > \"$tmp\" && mv \"$tmp\" \"$SAKUSEN_DONE_DIR/${SAKUSEN_DONE_PREFIX:-step}-$(date +%s%N).json\" || true"
          }
        ]
      }
    ]
  }
}
